# Database Configuration
POSTGRES_USER=polymarket
POSTGRES_PASSWORD=polymarket_pass
POSTGRES_DB=polymarket
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Polymarket CLOB trading (real order execution)
# TRADING_ENABLED=false keeps the pipeline in paper-trading mode (default, safe).
# Set to true only after filling in the wallet fields below.

TRADING_ENABLED=false
BET_AMOUNT_USD=1.0

POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137

# Private key of the wallet that SIGNS orders
POLYMARKET_PRIVATE_KEY=
# Address that actually holds your USDC/outcome tokens.
# - signature_type=1: your Polymarket proxy wallet address (legacy Magic-login accounts,
#   wallet deployed before 2026-05-04). Find it in Polymarket account/wallet settings.
# - signature_type=3: your Deposit Wallet address (accounts deployed on/after 2026-05-04).
#   Find it via the Polymarket profile menu -> copy account wallet address.
# If signature_type=1 is rejected with "maker address not allowed, please use the deposit
# wallet flow", your account is a Deposit Wallet - switch to signature_type=3 and use the
# Deposit Wallet address here instead.
POLYMARKET_FUNDER_ADDRESS=
# 0 = raw EOA wallet, 1 = email/Magic login (legacy proxy wallet), 2 = browser-wallet proxy,
# 3 = Deposit Wallet (accounts created/deployed on or after 2026-05-04).
POLYMARKET_SIGNATURE_TYPE=1

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# API Rate Limiting
MAX_REQUESTS_PER_SECOND=1
MIN_REQUEST_INTERVAL_MS=100

# Performance Tuning
WORKER_CONCURRENCY=8
WORKER_PREFETCH_MULTIPLIER=1
WEBSERVER_WORKERS=4

# S3 Credentials
AWS_ACCESS_KEY_ID=s3admin
AWS_SECRET_ACCESS_KEY=s3admin
AWS_DEFAULT_REGION=us-east-1

# RustFS
RUSTFS_CONSOLE_ENABLE=true
S3_BUCKET=mlflow
RUSTFS_ADDRESS=:9000
RUSTFS_SERVER_DOMAINS=storage:9000
AWS_S3_ADDRESSING_STYLE=path

# MLflow
# PIN THIS. It must match the mlflow client version in flows/pyproject.toml.
# The prefect-worker gets MLFLOW_BACKEND_STORE_URI, so its mlflow client can migrate the
# tracking DB schema directly. On 2026-08-24 the worker (3.15.1) upgraded the schema to
# revision 6f8d9c3b2a1e while the server was still a cached `latest` (3.14.0), which then
# refused to start: "Detected out-of-date database schema". The server was behind the DB,
# not the other way round, so `mlflow db upgrade` could not fix it.
MLFLOW_VERSION=v3.15.1
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=4444
MLFLOW_RUNS_MAX_AGE_HOURS=24
MLFLOW_S3_IGNORE_TLS=true

MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER:-polymarket}:${POSTGRES_PASSWORD:-polymarket_pass}@postgres:${POSTGRES_PORT:-5432}/mlflow
MLFLOW_ARTIFACTS_DESTINATION=s3://${S3_BUCKET}
MLFLOW_S3_ENDPOINT_URL=http://storage:9000
MLFLOW_SERVER_ALLOWED_HOSTS="*"

MLFLOW_TRACKING_USERNAME=admin
MLFLOW_TRACKING_PASSWORD=password1234
MLFLOW_FLASK_SERVER_SECRET_KEY=ReplaceWithAVeryLongSecureSecretKey123

# Model serving
MLFLOW_TRACKING_URI=http://mlflow:${MLFLOW_PORT}
MODEL_SERVE_NAME=polymarket-rf-model
MODEL_SERVE_HOST=0.0.0.0
MODEL_SERVE_PORT=3000
MODEL_POLL_INTERVAL=5

# WebSocket URLs for listeners
POLYMARKET_WS_URL=wss://ws-live-data.polymarket.com/
BINANCE_WS_URL=wss://fstream.binance.com/public/ws
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
POLYMARKET_ORDER_BOOK_WSS=wss://ws-subscriptions-frontend-clob.polymarket.com/ws/market

# Listeners settings
LOG_PUBLISHED_EVERY=100
METRICS_POLL_INTERVAL_S=5

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=polymarket_admin

# Prefect
PREFECT_API_URL=http://prefect-server:4200/api
PREFECT_SERVER_UI_API_URL=http://localhost:4200/api
PREFECT_RUNS_MAX_AGE_HOURS=48

# Flow worker settings
SAVE_RAW_DATA=false
